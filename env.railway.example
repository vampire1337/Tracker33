# Переменные окружения для Railway (минимальная конфигурация)

# Django основные настройки
SECRET_KEY=your_generated_secret_key_here
DEBUG=False
DJANGO_SETTINGS_MODULE=Tracker33.settings

# Хосты (Railway автоматически добавляет *.railway.app)
ALLOWED_HOSTS=*.railway.app,localhost,127.0.0.1

# CORS для фронтенда (если нужен)
CORS_ALLOWED_ORIGINS=https://your-app-name.up.railway.app

# База данных - НЕ НУЖНА! Используем SQLite
# DATABASE_URL - автоматически от Railway, но мы не используем

# Кэш - НЕ НУЖЕН! Используем локальную память  
# REDIS_URL - не используем для экономии ресурсов

# Email (опционально, для сброса паролей)
# EMAIL_HOST_USER=your_email@example.com
# EMAIL_HOST_PASSWORD=your_email_password

# Уведомления (опционально)
# SLACK_WEBHOOK_URL=
# DEFAULT_SLACK_CHANNEL=

# Примечания:
# - SQLite база данных создается автоматически
# - Статические файлы обрабатывает WhiteNoise  
# - Кэш использует локальную память
# - Минимальное потребление ресурсов: ~50MB RAM
