[Unit]
Description=Tracker33 Django Application
Requires=postgresql.service
After=network.target postgresql.service

[Service]
Type=notify
User=tracker33
Group=www-data
RuntimeDirectory=tracker33
WorkingDirectory=/home/tracker33/tracker33
Environment=DJANGO_SETTINGS_MODULE=Tracker33.settings
EnvironmentFile=/home/tracker33/tracker33/.env.production
ExecStart=/home/tracker33/tracker33/.venv/bin/gunicorn --config /etc/tracker33/gunicorn.conf.py Tracker33.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/tracker33 /var/run/tracker33 /home/tracker33/tracker33/media /tmp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target